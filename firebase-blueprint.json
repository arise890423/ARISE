{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Hunter public profile and presence status",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "username": { "type": "string" },
        "title": { "type": "string" },
        "bio": { "type": "string" },
        "rank": { "type": "string" },
        "level": { "type": "number" },
        "isOnline": { "type": "boolean" },
        "showOnlineStatus": { "type": "boolean" },
        "avatarResName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "createdAt"]
    },
    "CommunityRoom": {
      "title": "CommunityRoom",
      "description": "Guild rooms, group conversations, and direct chats",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["PUBLIC_ROOM", "GROUP", "DIRECT"] },
        "creatorId": { "type": "string" },
        "lastMessage": { "type": "string" },
        "lastSenderName": { "type": "string" },
        "lastMessageTimestamp": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "creatorId", "createdAt"]
    },
    "RoomMessage": {
      "title": "RoomMessage",
      "description": "Chat messages sent inside a room",
      "type": "object",
      "properties": {
        "roomId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderRank": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "text", "createdAt"]
    },
    "UserReport": {
      "title": "UserReport",
      "description": "Abuse and spam report records",
      "type": "object",
      "properties": {
        "reporterId": { "type": "string" },
        "reportedUserId": { "type": "string" },
        "reportedMessageId": { "type": "string" },
        "reason": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reporterId", "reason", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Hunter profiles and settings"
    },
    "/community_rooms/{roomId}": {
      "schema": { "$ref": "#/entities/CommunityRoom" },
      "description": "Community and Guild rooms"
    },
    "/community_rooms/{roomId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/RoomMessage" },
      "description": "Messages inside rooms"
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/UserReport" },
      "description": "User abuse and spam reports"
    }
  }
}

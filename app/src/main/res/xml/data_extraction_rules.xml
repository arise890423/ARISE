<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude credentials, session tokens, and secure preferences from cloud backup -->
        <exclude domain="sharedpref" path="arise_secure_prefs.xml" />
        <exclude domain="sharedpref" path="arise_hunter_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="arise_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
